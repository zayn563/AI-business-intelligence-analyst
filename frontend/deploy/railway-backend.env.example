# ============================================================
# AI BUSINESS INTELLIGENCE ANALYST
# Railway Backend Variable Reference
#
# DOCUMENTATION ONLY.
# Do not put real passwords or service-account JSON here.
# ============================================================


# ============================================================
# POSTGRESQL
#
# These should be configured as Railway reference variables
# from the Postgres service.
# ============================================================

DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_NAME=${{Postgres.PGDATABASE}}
DB_USER=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}


# ============================================================
# OLLAMA
#
# Keep Ollama private inside Railway.
# ============================================================

OLLAMA_HOST=http://ollama.railway.internal:11434

OLLAMA_MODEL=qwen3:4b


# ============================================================
# GOOGLE SHEETS
#
# GOOGLE_SERVICE_ACCOUNT_JSON must be configured manually as
# a Railway secret.
#
# Never commit the actual JSON.
# ============================================================

GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-service-account.json

GOOGLE_SERVICE_ACCOUNT_JSON=SET_THIS_SECURELY_IN_RAILWAY


# ============================================================
# APPLICATION
# ============================================================

HOST=0.0.0.0

LOG_LEVEL=info